<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:background="@drawable/header_background"
    android:elevation="4dp"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:minHeight="56dp">

    <!-- Скрытые View для обратной совместимости -->
    <View android:id="@+id/nav_back_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/nav_tab_instances" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/nav_divider" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- Логотип + название (слева) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/misans"
            android:text="@string/app_name"
            android:textColor="#00D4FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ПУСТОЕ ПРОСТРАНСТВО СЛЕВА ОТ КАПСУЛЫ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Навигационная капсула (по центру) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/nav_pill_bg_shape"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/nav_tab_launch"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_home"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/nav_tab_settings"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_settings"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent" />

            <ImageView
                android:id="@+id/nav_tab_about"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_about"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </FrameLayout>

    <!-- ПУСТОЕ ПРОСТРАНСТВО СПРАВА ОТ КАПСУЛЫ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sign In (справа) -->
    <Button
        android:id="@+id/nav_sign_in_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:backgroundTint="@color/primary"
        android:text="@string/sign_in"
        android:textColor="@color/on_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:visibility="visible" />

</LinearLayout>
