<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="0dp"
    android:layout_marginRight="0dp"
    android:layout_marginTop="0dp"
    android:background="@drawable/header_background"
    android:elevation="4dp"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:minHeight="56dp">

    <View android:id="@+id/nav_back_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/nav_tab_instances" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/nav_divider" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/misans"
            android:text="@string/app_name"
            android:textColor="#00D4FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/nav_pill_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/nav_tab_launch"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_home"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <ImageView
                android:id="@+id/nav_tab_settings"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_settings"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <ImageView
                android:id="@+id/nav_tab_about"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_about"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_sign_in_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/misans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:backgroundTint="@color/primary"
            android:text="@string/sign_in"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/nav_account_avatar_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="gone">

            <com.microsoft.xbox.idp.toolkit.CircleImageView
                android:id="@+id/nav_account_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/xbox_avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_minecraft_cube" />

            <ProgressBar
                android:id="@+id/nav_avatar_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
